# Copy this file to .env and fill in real values.

# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=paste-your-own-generated-value-here
SESSION_TIMEOUT_MINUTES=30

# How OTPs are delivered (Scenarios 2 and 3):
#   console  -> print the OTP in the server terminal (no setup needed)
#   mailtrap -> send a mock email to your Mailtrap sandbox inbox
# Unset or unrecognised values fall back to console.
OTP_DELIVERY_MODE=console

# Only needed when OTP_DELIVERY_MODE=mailtrap

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username_here
MAILTRAP_PASS=your_mailtrap_password_here

# Server options (optional)
# FLASK_HOST=0.0.0.0   # expose to other machines, e.g. a Kali VM. Default: 127.0.0.1
# FLASK_DEBUG=1        # Werkzeug debugger. Local use only, never together with 0.0.0.0
